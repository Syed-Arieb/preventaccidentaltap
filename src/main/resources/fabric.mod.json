{
	"schemaVersion": 1,
	"id": "preventaccidentaltap",
	"version": "${version}",
	"name": "PreventAccidentalTap",
	"description": "Intercepts and throttles mouse inputs when interacting with chests, enforcing a single tap per click while holding an item.",
	"authors": [
		"Purpur"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/preventaccidentaltap/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.purpur.pat.PreventAccidentalTap"
		],
		"client": [
			"com.purpur.pat.client.PreventAccidentalTapClient"
		]
	},
	"mixins": [
		"preventaccidentaltap.mixins.json",
		{
			"config": "preventaccidentaltap.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}